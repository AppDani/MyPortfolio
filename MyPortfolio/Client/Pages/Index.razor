@page "/"

<PageTitle>Daniela Rog-Schwartz | Portfolio</PageTitle>

<!-- ===== NAV ===== -->
<nav class="portfolio-nav">
    <div class="nav-inner">
        <a href="#hero" class="nav-logo">Daniela Rog-Schwartz</a>
        <button class="nav-toggle" aria-label="Toggle navigation"
                onclick="this.nextElementSibling.classList.toggle('open')">&#9776;</button>
        <ul class="nav-links">
            <li><a href="#projects">Projects</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#skills">Skills</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
    </div>
</nav>

<!-- ===== HERO ===== -->
<section id="hero" class="hero-section">
    <div class="hero-blob"></div>
    <div class="hero-inner">

        <!-- Drop your photo at wwwroot/images/profile.jpg to replace the initials placeholder -->
        <div class="hero-photo">
            <div class="hero-photo-initials">DR</div>
        </div>

        <h1 class="hero-name">Daniela Rog-Schwartz</h1>

        <div class="hero-role-wrap">
            <span class="hero-role">Technical Product Developer &amp; Designer</span>
        </div>

        <p class="hero-subtitle">
            Creating engaging learning experiences through
            <span class="hl hl-green">interactive content</span>,
            <span class="hl hl-blue">digital tools</span>,
            and <span class="hl hl-purple">user-centered design</span>
        </p>

        <div class="hero-pills">
            <span class="hero-pill hero-pill-green">Game Development</span>
            <span class="hero-pill hero-pill-blue">Web Development</span>
            <span class="hero-pill hero-pill-purple">Instructional Design</span>
        </div>

        <a href="#projects" class="hero-cta">
            View My Work
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
        </a>
    </div>
</section>

<!-- ===== PROJECTS ===== -->
<section id="projects">
    <div class="section-container">
        <div class="section-title-wrap">
            <div class="section-title-inner">
                <div class="section-title-underline"></div>
                <h2 class="section-title">Featured Projects</h2>
            </div>
        </div>

        <div class="projects-grid">
            @foreach (var p in _projects)
            {
                <ProjectCard
                    Title="@p.Title"
                    Category="@p.Category"
                    AccentColor="@p.AccentColor"
                    AccentColorDark="@p.AccentColorDark"
                    Description="@p.Description"
                    Tags="@p.Tags"
                    ImageFileName="@p.ImageFileName"
                    MediaItems="@p.MediaItems"
                    Link="@p.Link" />
            }
        </div>
    </div>
</section>

<!-- ===== ABOUT ===== -->
<section id="about">
    <div class="section-container">
        <div class="section-title-wrap">
            <div class="section-title-inner">
                <div class="section-title-underline"></div>
                <h2 class="section-title">About Me</h2>
            </div>
        </div>

        <div class="about-grid">
            <div class="about-bio-wrap">
                <div class="about-bio">
                    <p>I am a Unity Technical Artist &amp; Game Developer specialising in the intersection of art, design, and engineering. My focus is on building high-performance, visually stunning experiences by bridging the gap between creative vision and technical constraints.</p>
                    <p>With proficiency in C# scripting and Unity systems, I develop scalable game architectures, custom HLSL shaders, and dynamic particle effects. I take full ownership of the development pipeline — from initial prototyping to final deployment.</p>
                    <p>My background in Instructional Technologies provides a unique advantage in creating user-centered interactive systems with clear progression and intuitive feedback. I leverage AI-assisted workflows to streamline production and ensure the highest level of visual polish and technical precision.</p>
                </div>
            </div>

            <div class="about-cards">
                <div class="about-info-card education">
                    <div class="about-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 3.741-3.342" />
                        </svg>
                    </div>
                    <div class="about-card-content">
                        <h3>Education</h3>
                        <p>B.A. in Instructional Technologies, Holon Institute of Technology (expected 2026) · Application Development at HackerU (2021–2023)</p>
                    </div>
                </div>

                <div class="about-info-card approach">
                    <div class="about-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" />
                        </svg>
                    </div>
                    <div class="about-card-content">
                        <h3>Approach</h3>
                        <p>Focused on performance optimisation and clean, modular C# code. I balance artistic vision with technical precision in every project.</p>
                    </div>
                </div>

                <div class="about-info-card experience">
                    <div class="about-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                        </svg>
                    </div>
                    <div class="about-card-content">
                        <h3>Experience</h3>
                        <p>10+ years in educational and service roles · ChildCare provider (2014–present) · Back Office, XYX Media Technologies (2020–2021)</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== SKILLS ===== -->
<section id="skills">
    <div class="section-container">
        <div class="section-title-wrap">
            <div class="section-title-inner">
                <div class="section-title-underline"></div>
                <h2 class="section-title">Skills &amp; Expertise</h2>
            </div>
        </div>

        <div class="skills-grid">
            @foreach (var s in _skills)
            {
                <div class="skill-card">
                    <div class="skill-icon-wrap" style="background-color: @s.Color">
                        @((MarkupString)s.SvgIcon)
                    </div>
                    <h3 class="skill-title">@s.Title</h3>
                    <div class="skill-tags">
                        @foreach (var t in s.Tags)
                        {
                            <span class="tech-tag">@t</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ===== CONTACT ===== -->
<section id="contact" class="contact-section">
    <div class="section-container">
        <div class="contact-title-inner">
            <div class="contact-title-underline"></div>
            <h2 class="contact-title">Let's Connect!</h2>
        </div>

        <p class="contact-subtitle">
            I'm always excited to discuss
            <span class="hl-contact-blue">new projects</span>,
            <span class="hl-contact-pink">collaboration</span>,
            or just chat about educational tech!
        </p>

        <div class="contact-buttons">
            <a href="mailto:danielarog10@gmail.com?subject=Portfolio%20Inquiry"
               class="contact-btn contact-btn-email">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="white">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                </svg>
                Email
            </a>

            <a href="https://www.linkedin.com/in/daniela-rog-aa1b8420a/" target="_blank" rel="noopener"
               class="contact-btn contact-btn-linkedin">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                </svg>
                LinkedIn
            </a>

            <a href="images/resume.pdf" target="_blank" rel="noopener"
               class="contact-btn contact-btn-resume">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="white">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                </svg>
                Resume
            </a>
        </div>

        <div class="contact-footer">
            <p>© 2026 Daniela Rog-Schwartz · Designed and built with passion and creativity</p>
        </div>
    </div>
</section>

